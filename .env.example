# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
# Used by the Service Booking app's Phase 2 (booking drawer: address map + payment).
# Not required to run Phase 1 (catalog/cart) — settings.py defaults all of these to ''.

# Core Django security settings — safe to leave unset for local dev
# (settings.py falls back to dev-only defaults: DEBUG=True, a placeholder
# SECRET_KEY, and a wildcard ALLOWED_HOSTS). A REAL DEPLOYMENT MUST SET
# ALL THREE: a fresh secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`),
# DEBUG=False, and the real domain(s) actually serving the site.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*,0.0.0.0,localhost,0.0.0.0:8005

# Google Maps JavaScript API key — powers the address-selection map step.
GOOGLE_MAPS_API_KEY=

# Set to True only once billing is enabled on the Google Cloud project tied
# to the key above — a key alone isn't enough; without billing every Maps
# Platform call fails with REQUEST_DENIED. Until then, the address step
# uses free/keyless Leaflet + OpenStreetMap + Nominatim (kept in the
# codebase either way — see booking_drawer.js).
USE_GOOGLE_MAPS_FOR_ADDRESS=False

# Razorpay (test-mode keys while developing — https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Authentication (django-allauth) — email/password login works with none of
# these set. Google/Apple sign-in buttons render either way but won't
# complete a real login until these are filled in. See developed.md
# "Authentication".

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
# (Services ID) and .../authkeys (Sign in with Apple key, downloads a .p8 once)
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# MessageCentral "Verify Now" (phone-number OTP login) — https://www.messagecentral.com
# SMS_KEY: copy the "Auth Token" from your dashboard's API Credentials
# page as-is — it's a JWT that already carries your customerId.
# MESSAGECENTRAL_PASSWORD: your actual dashboard login password — a
# SEPARATE credential, needed because their API requires exchanging it
# for a short-lived session token before send/validate will accept
# anything (see accounts/messagecentral.py::_generate_session_token).
# Without both, "Continue with Phone Number" can't send/validate a code.
SMS_KEY=
MESSAGECENTRAL_PASSWORD=

# False (default): prints the OTP to the console instead of calling
# MessageCentral for real — no credits spent, works with none of the
# above set. True: send/validate real SMS via the live gateway.
OTP_GATEWAY=False
