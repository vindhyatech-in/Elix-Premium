# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
# Used by the Service Booking app's Phase 2 (booking drawer: address map + payment).
# Not required to run Phase 1 (catalog/cart) — settings.py defaults all of these to ''.

# Google Maps JavaScript API key — powers the address-selection map step.
GOOGLE_MAPS_API_KEY=

# Set to True only once billing is enabled on the Google Cloud project tied
# to the key above — a key alone isn't enough; without billing every Maps
# Platform call fails with REQUEST_DENIED. Until then, the address step
# uses free/keyless Leaflet + OpenStreetMap + Nominatim (kept in the
# codebase either way — see booking_drawer.js).
USE_GOOGLE_MAPS_FOR_ADDRESS=False

# Razorpay (test-mode keys while developing — https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Authentication (django-allauth) — email/password login works with none of
# these set. Google/Apple sign-in buttons render either way but won't
# complete a real login until these are filled in. See developed.md
# "Authentication".

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
# (Services ID) and .../authkeys (Sign in with Apple key, downloads a .p8 once)
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
