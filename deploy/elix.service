[Unit]
Description=Gunicorn daemon for Elix (elix.vindhyatech.in)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/elix
# No EnvironmentFile= here — python-decouple reads /var/www/elix/.env
# directly (it searches upward from GlamourAtHome/settings.py's own
# directory, landing on WorkingDirectory), same as local dev.
ExecStart=/var/www/elix/venv/bin/gunicorn \
    --workers 3 \
    --timeout 60 \
    --bind unix:/run/elix.sock \
    GlamourAtHome.wsgi:application
Restart=on-failure
RestartSec=3

# This VM also runs other, unrelated projects — deliberately scoped to
# nothing beyond "restart on crash". No extra sandboxing/resource limits
# here since this is a demo box, not a hardened production host.

[Install]
WantedBy=multi-user.target
